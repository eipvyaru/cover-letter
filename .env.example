APP_PUBLIC_URL=https://cover-letter.ai-run.ru
LOCAL_APP_PUBLIC_URL=http://127.0.0.1:8792
SOURCE_ALLOWED_HOST_MASKS_JSON='["*.^[A-Za-z][A-Za-z0-9]*$.ru"]'
PORT=8792
PLAYWRIGHT_HOST=127.0.0.1
PLAYWRIGHT_PORT=8791
LLM_API_ENDPOINT=https://api.kodikrouter.ru/v1
LLM_API_KEY="replace-locally"
LLM_DEFAULT_MODEL=openai/gpt-5.6-luna
LLM_MODELS_JSON='[{"name":"GPT-5.6 Luna","modelId":"openai/gpt-5.6-luna","enabled":true,"isDefault":true,"supportsTemperature":false}]'
LLM_TIMEOUT_MS=180000
LLM_MAX_OUTPUT_TOKENS=8000
SYSTEM_PROMPT_PATH=C:\_Codex\cover-letter\data\system_prompt.md
DATABASE_PATH=C:\_Codex\cover-letter\data\cover-letter.sqlite
ADMIN_LOGIN="replace-locally"
ADMIN_PASSWORD_HASH="replace-locally"
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-bytes"
SESSION_TTL_MINUTES=720
MAX_SESSIONS=5
MAX_MESSAGE_LENGTH=140000
HISTORY_LIMIT=30
HISTORY_RETENTION_DAYS=30
RATE_LIMIT_PER_MINUTE=5
